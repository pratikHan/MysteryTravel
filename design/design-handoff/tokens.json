{
  "meta": {
    "app": "Mystery City Adventures",
    "decision_required": "Pick ONE ink before building: inkBrown (Explore canvas set) or inkNavy (concept screens 1-25 + Set Preferences). Everything else is shared.",
    "font_source": "Google Fonts"
  },
  "color": {
    "inkBrown": "#27211A",
    "inkNavy": "#16325A",
    "mutedBrown": "#6E6459",
    "mutedNavy": "#54627E",
    "ground": "#F7F2E8",
    "groundWarm": "#F8F3E2",
    "surface": "#FFFFFF",
    "cardWarm": "#FBECCD",
    "border": "#E4DBC9",
    "borderWarm": "#EFE2C4",
    "pillDark": "#211B15",
    "pillNavy": "#112C4A",
    "onDark": "#FFF7EA",
    "heart": "#FF6B74",
    "accent": {
      "peaceful": "#3E8E5B",
      "night": "#8A4FD3",
      "artistic": "#E8862B",
      "stories": "#D94F4F"
    },
    "accentSoftRule": "soft fill = accent mixed 16% into white; soft border = accent mixed 45% into white"
  },
  "type": {
    "family": "Nunito",
    "weights": [600, 700, 800],
    "scale": {
      "displayTitle": { "size": 27, "weight": 800, "lineHeight": 1.22, "letterSpacing": -0.3 },
      "screenTitle": { "size": 26, "weight": 800, "letterSpacing": -0.3 },
      "detailTitle": { "size": 24, "weight": 800, "letterSpacing": -0.3 },
      "sectionHeader": { "size": 17, "weight": 800 },
      "body": { "size": 14, "weight": 600, "lineHeight": 1.45 },
      "itemTitle": { "size": 14, "weight": 800 },
      "chip": { "size": 12, "weight": 700 },
      "meta": { "size": 12, "weight": 800 },
      "metaSub": { "size": 11, "weight": 600 },
      "caption": { "size": 10.5, "weight": 700 },
      "cta": { "size": 16, "weight": 800 },
      "tabLabel": { "size": 10, "weight": 700 }
    }
  },
  "space": { "xs": 4, "s": 8, "m": 12, "l": 14, "xl": 18, "xxl": 22, "screenGutter": 18, "prefsGutter": 22 },
  "radius": { "pill": 999, "sheet": 26, "card": 18, "thumb": 14, "small": 12, "phoneFrame": 28 },
  "size": { "cta": 54, "iconButton": 40, "badge": 46, "stopNumber": 26, "stopThumb": 48, "expectThumb": 86, "touchMin": 44 },
  "motion": {
    "press": { "ms": 150, "scale": 0.97 },
    "base": { "ms": 250, "curve": "easeOut" },
    "pop": { "ms": 300, "curve": "overshoot", "peakScale": 1.2 },
    "heartPop": { "ms": 350, "peakScale": 1.35 },
    "cardLift": { "ms": 250, "translateY": -4 },
    "float": { "ms": 4500, "translateY": -5, "loop": "easeInOut alternate" },
    "kenburns": { "ms": 10000, "scaleTo": 1.07, "loop": "easeInOut alternate" },
    "rule": "every duration and curve references this table; all loops stop under reduced-motion"
  }
}
